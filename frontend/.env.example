# SecureRecon Frontend Environment Variables
# Optional: Set these if connecting the Vercel frontend to an external FastAPI backend (e.g. Render, Railway, Fly.io, or VPS).
# If left unset, the frontend defaults to '/api' and uses the built-in demo simulations and fallbacks.

# Base URL of your backend API (e.g. https://securerecon-api.onrender.com/api or /api)
VITE_API_BASE=

# Base URL of your backend WebSocket server (e.g. wss://securerecon-api.onrender.com)
VITE_WS_BASE=
